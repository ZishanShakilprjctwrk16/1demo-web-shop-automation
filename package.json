{
  "name": "demo-web-shop-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Demo Web Shop UI automation with Playwright + POM and API automation with Postman/Newman.",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:q1": "node scripts/run-tests.mjs tests/q1-invalid-login.spec.ts",
    "test:q2": "node scripts/run-tests.mjs tests/q2-register-cart.spec.ts",
    "test:q3": "node scripts/run-tests.mjs tests/q3-e2e-checkout.spec.ts",
    "test:headed": "node scripts/run-tests.mjs --headed",
    "test:ui": "playwright test --ui",
    "report:html": "playwright show-report playwright-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "api:test": "newman run api-tests/DemoWebShop_API.postman_collection.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.3",
    "newman": "^6.2.1",
    "typescript": "^5.9.2"
  }
}
